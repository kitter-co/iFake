{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iFake",
  "version": "0.1.0",
  "identifier": "com.kitter.ifake",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "iFake",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1100,
        "height": 700,
        "minWidth": 784,
        "minHeight": 700 ,
        "trafficLightPosition": {
          "x": 26,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
